# =============================================================================
# VeriHire AI — Root .env.example
#
# Copy this file to .env and fill in all required values.
# NEVER commit a .env file with real secrets to version control.
# ==============================================================================
# VeriHire AI — Environment Configuration (BYOK Architecture)
# ==============================================================================
#
# Instructions:
# 1. Copy this file to `.env` in the root directory.
# 2. Fill in the Supabase PostgreSQL credentials.
# 3. Generate a secure JWT secret and APP_ENCRYPTION_KEY.
#
# NOTE: AI Provider keys (Groq/GitHub) are NO LONGER configured here.
# Each recruiter brings their own keys via the VeriHire web interface.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# Database Configuration (Supabase / PostgreSQL)
# ──────────────────────────────────────────────────────────────────────────────
# JDBC URL for Spring Boot (ensure prepareThreshold=0 is present for Supabase)
SUPABASE_JDBC_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?prepareThreshold=0

# Database credentials
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your_super_secret_db_password

# ──────────────────────────────────────────────────────────────────────────────
# Security & Encryption (Required)
# ──────────────────────────────────────────────────────────────────────────────
# JWT Secret for authentication tokens (Min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_chars_long

# AES-256 Encryption Key for BYOK User Settings (MUST BE EXACTLY 32 CHARS)
# e.g., run `openssl rand -hex 16`
APP_ENCRYPTION_KEY=your_32_character_encryption_key_

# ──────────────────────────────────────────────────────────────────────────────
# Network & CORS Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Allowed origins for the frontend. Default covers Docker and local dev.
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:5174,http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Application Settings (Optional overrides)
# ──────────────────────────────────────────────────────────────────────────────
# Logging levels (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Timeout for Python AI layer requests (in minutes)
AI_SERVICE_TIMEOUT_MINUTES=30

# Python AI Service URL (change only if running AI separately)
# In Docker Compose this is automatically set to http://python-ai:8000
AI_SERVICE_URL=http://localhost:8000

# Database connection pool
DB_POOL_SIZE=10

# Logging
LOG_LEVEL=INFO
JPA_SHOW_SQL=false

# =============================================================================
# Frontend (Vite)
# Place in frontend/.env (not this file)
# =============================================================================
# VITE_API_URL=http://localhost:8080
