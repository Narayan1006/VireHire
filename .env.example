# VeriHire v2 Environment Variables (Names only — never put real values here)

# API (apps/api) — set these in the Render dashboard
DATABASE_URL=
JWT_SECRET=
CORS_ORIGINS=https://<project>.vercel.app
ENV=

# External integrations (used in future milestones)
GROQ_API_KEY=
GITHUB_TOKEN=

# Web (apps/web) — set as Vercel environment variable
VITE_API_URL=https://verihire-api-v2.onrender.com
