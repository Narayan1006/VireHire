# =============================================================================
# VeriHire AI — Root .env.example
#
# Copy this file to .env and fill in all required values.
# NEVER commit a .env file with real secrets to version control.
# =============================================================================

# =============================================================================
# REQUIRED — Supabase PostgreSQL (Direct Connection)
# Find these in: Supabase Dashboard > Project Settings > Database
# =============================================================================
SUPABASE_JDBC_URL=jdbc:postgresql://<db-host>:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your-supabase-database-password

# =============================================================================
# REQUIRED — JWT Authentication
# Generate a strong secret: openssl rand -base64 64
# Minimum: 32 characters (256 bits recommended)
# =============================================================================
JWT_SECRET=your-base64-encoded-jwt-secret-min-32-chars
JWT_EXPIRATION_MS=86400000

# =============================================================================
# REQUIRED — AI Service API Keys
# =============================================================================
# Groq API key (Layer 3 LLM reasoning)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key

# GitHub Personal Access Token (Layer 2 evidence — public repo access only)
# https://github.com/settings/tokens (select: public_repo)
GITHUB_TOKEN=ghp_your-github-token

# =============================================================================
# OPTIONAL — Override defaults
# =============================================================================
# Python AI Service URL (change only if running AI separately)
# In Docker Compose this is automatically set to http://python-ai:8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MINUTES=30

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Database connection pool
DB_POOL_SIZE=10

# Logging
LOG_LEVEL=INFO
JPA_SHOW_SQL=false

# =============================================================================
# Frontend (Vite)
# Place in frontend/.env (not this file)
# =============================================================================
# VITE_API_URL=http://localhost:8080
