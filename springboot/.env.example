# =============================================================================
# VereHire AI — Spring Boot Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Supabase PostgreSQL Connection ───────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
# Format:   jdbc:postgresql://<host>:<port>/<database>
# Example:  jdbc:postgresql://db.abcxyz123.supabase.co:5432/postgres
SUPABASE_JDBC_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your-supabase-database-password

# ── JWT Configuration ─────────────────────────────────────────────────────────
# Generate a secure secret (minimum 256 bits / 32 bytes):
#   openssl rand -base64 64
# This secret is ONLY used by Spring Boot — it is NOT the Supabase JWT secret.
JWT_SECRET=replace-with-your-own-256-bit-secret-generated-with-openssl
JWT_EXPIRATION_MS=86400000

# ── Python AI Service ─────────────────────────────────────────────────────────
# Internal Docker network URL when running via docker-compose:
AI_SERVICE_URL=http://python-ai:8000
# For local development (Python running separately):
# AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
JPA_SHOW_SQL=false
SQL_LOG_LEVEL=WARN

# ── Connection Pool ────────────────────────────────────────────────────────────
DB_POOL_SIZE=10
